<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>一人一人の、花を咲かせる、居場所。</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Yuji+Syuku&family=Zen+Kurenaido&family=Klee+One:wght@400&display=swap" rel="stylesheet">
<style>
  :root{
    /* 背景色。ここを少し濃くすると白い文字が浮かび上がります（例: #f2efe9） */
    --bg: #ffffff;
    /* 文字（白）と、うっすら見える輪郭の色 */
    --ink: #ffffff;
    --ink-outline: #d9d9d9;
  }

  *{ margin:0; padding:0; box-sizing:border-box; }

  html,body{ height:100%; }

  body{
    background: var(--bg);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* 元画像が正方形なので、正方形の“ステージ”に composition を収める */
  .stage{
    position: relative;
    width: min(92vmin, 780px);
    aspect-ratio: 1 / 1;
    container-type: size;              /* cqmin をこの箱基準で使う */
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  /* 3列を横に並べる。row-reverse で DOM 上の1行目を右端に */
  .verse{
    display: flex;
    flex-direction: row-reverse;
    align-items: flex-start;
    height: 100%;
    gap: 6.4cqmin;                     /* 列と列の間隔 */
  }

  .line{
    writing-mode: vertical-rl;         /* 縦書き（上→下、列は右→左） */
    font-family: 'Yuji Syuku', 'Zen Kurenaido', 'Klee One', 'Hiragino Mincho ProN', serif;
    font-weight: 400;
    font-size: 6.6cqmin;               /* 1文字の大きさ */
    letter-spacing: 0.5em;             /* 縦方向（文字と文字）の間隔 */
    line-height: 1;
    color: var(--ink);
    /* 白文字の輪郭をうっすら描いて“見えるか見えないか”を再現 */
    -webkit-text-stroke: 0.4px var(--ink-outline);
    text-shadow: 0 0 1px rgba(200,200,200,.6);
  }

  /* 各列の開始位置を段々下げて、右上→左下の流れをつくる */
  .line-1{ margin-top: 4cqmin;  }      /* 一人一人の、 */
  .line-2{ margin-top: 19cqmin; }      /* 花を咲かせる、 */
  .line-3{ margin-top: 58cqmin; }      /* 居場所。 */

  /* スマホなどビューポートが狭いときも正方形比を維持 */
  @media (max-width: 480px){
    .stage{ width: 96vmin; }
  }
</style>
</head>
<body>
  <main class="stage">
    <div class="verse">
      <p class="line line-1">一人一人の、</p>
      <p class="line line-2">花を咲かせる、</p>
      <p class="line line-3">居場所。</p>
    </div>
  </main>
</body>
</html>